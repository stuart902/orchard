#!/bin/sh
# Allow suspend only on a board whose orchard device data says it works
# (device.toml [features] suspend = "working"; the platform layer lists their
# device-tree compatibles). Every other board gets AllowSuspend=no, so an
# untested board cannot be put to sleep by accident. A distribution's own
# sleep.conf.d drop-in that sorts later can still forbid it.
# See docs/bring-up/suspend.md.
set -eu
boards=${ORCHARD_SUSPEND_BOARDS:-/usr/lib/orchard/suspend-boards}
compatible=${ORCHARD_COMPATIBLE:-/proc/device-tree/compatible}
out=${ORCHARD_SLEEP_CONF_DIR:-/run/systemd/sleep.conf.d}
allow=no
board=unknown
if [ -r "$compatible" ]; then
    board=$(tr '\0' '\n' < "$compatible" | head -n 1)
    if [ -r "$boards" ]; then
        for name in $(tr '\0' '\n' < "$compatible"); do
            if grep -qxF -- "$name" "$boards"; then allow=yes; break; fi
        done
    fi
fi
mkdir -p "$out"
tmp="$out/.50-orchard-board.conf.$$"
printf '%s\n' '[Sleep]' \
    "# Written at boot by orchard for $board from its device data." \
    "AllowSuspend=$allow" > "$tmp"
mv -f "$tmp" "$out/50-orchard-board.conf"
