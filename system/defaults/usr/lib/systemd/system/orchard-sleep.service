[Unit]
Description=Allow suspend where the board's device data says it works
Documentation=https://github.com/OrchardLinux/orchard/blob/main/docs/bring-up/suspend.md
DefaultDependencies=no
Before=sysinit.target systemd-logind.service
ConditionPathExists=/proc/device-tree/compatible

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/orchard/orchard-sleep
