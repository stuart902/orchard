#!/bin/sh
# This checkout's orchard: runs exactly the code next to it, wherever it is
# called from. uv installs the checkout editable, so an edit to a .py file
# counts from the next command; nothing is packaged.
#
#   bin/orchard ARGS          orchard ARGS, from this checkout
#   bin/orchard python ARGS   Python in this checkout's environment
#
# The `orchard` on PATH is tools/launcher, which runs the newest nightly.
set -eu

script=$0
while [ -L "$script" ]; do
    target=$(readlink "$script")
    case $target in
        /*) script=$target ;;
        *) script=$(dirname "$script")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)

# An older setup linked ~/.local/bin/orchard to mainline's bin/orchard; that
# role is tools/launcher's now (the newest nightly), until orchard update
# installs it in the link's place.
cache=${ORCHARD_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/orchard}
if [ "$root" = "$(cd "$cache/orchard-main" 2>/dev/null && pwd -P)" ] && [ -f "$root/tools/launcher" ]; then
    [ "${1:-}" = update ] || echo 'orchard: run orchard update once to install the new launcher' >&2
    exec sh "$root/tools/launcher" "$@"
fi

command -v uv >/dev/null 2>&1 || {
    echo 'orchard: install uv: https://docs.astral.sh/uv/getting-started/installation/' >&2
    exit 1
}
export UV_PROJECT_ENVIRONMENT="$root/.venv"
case ${1:-} in
    python) shift; exec uv run --quiet --project "$root" python "$@" ;;
    *) exec uv run --quiet --project "$root" orchard "$@" ;;
esac
