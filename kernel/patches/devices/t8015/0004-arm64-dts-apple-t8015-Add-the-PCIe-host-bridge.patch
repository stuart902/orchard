From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Eduardo Martins <eduardo@martins.ws>
Date: Sat, 31 Oct 2026 16:40:52 -0500
Subject: [PATCH] arm64: dts: apple: t8015: Add the PCIe host bridge

The A11 has the same four-port H8P/H9P root complex as the A10, but no
storage port. The runtime ADT places the ECAM window at 0x610000000, the
root complex block at 0x600000000, the PHY at 0x600080000 and 0x6000c0000,
and the port registers at 0x60N000000. The four port state interrupts are
340/343/346/349, and the MSI block starts at 352.

The ADT also lists a 0x4000 window at 0x60N004000 next to each port;
nothing identifies it, and the driver does not use it, so it is left out.

Describe the controller but leave it disabled by default; the d221 board
enables it.

[Orchard: left out the four unidentified 0x60N004000 windows; reg order as on T8010]
Signed-off-by: Eduardo Martins <eduardo@martins.ws>
Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8015.dtsi | 43 ++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8015.dtsi b/arch/arm64/boot/dts/apple/t8015.dtsi
index 3ddce22..0cf1942 100644
--- a/arch/arm64/boot/dts/apple/t8015.dtsi
+++ b/arch/arm64/boot/dts/apple/t8015.dtsi
@@ -725,6 +725,49 @@
 			power-domain-names = "ans", "apcie0";
 			resets = <&ps_ans2>;
 		};
+
+		apcie: pcie@610000000 {
+			compatible = "apple,t8015-pcie";
+			device_type = "pci";
+
+			reg = <0x6 0x10000000 0x0 0x1000000>,
+			      <0x6 0x00000000 0x0 0x50000>,
+			      <0x6 0x00080000 0x0 0x4000>,
+			      <0x6 0x000c0000 0x0 0x40000>,
+			      <0x6 0x01000000 0x0 0x4000>,
+			      <0x6 0x02000000 0x0 0x4000>,
+			      <0x6 0x03000000 0x0 0x4000>,
+			      <0x6 0x04000000 0x0 0x4000>;
+			reg-names = "config", "rc", "phy", "phy-ip",
+				    "port0", "port1", "port2", "port3";
+
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 340 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 343 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 346 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 349 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "port0", "port1", "port2", "port3";
+
+			msi-controller;
+			msi-parent = <&apcie>;
+			msi-ranges = <&aic AIC_IRQ 352 IRQ_TYPE_EDGE_RISING 32>;
+			apple,msi-doorbell = <0xbffff000>;
+
+			#address-cells = <3>;
+			#size-cells = <2>;
+			#interrupt-cells = <1>;
+			interrupt-controller;
+			bus-range = <0x00 0x08>;
+			ranges = <0x43000000 0x6 0x20000000
+				  0x6 0x20000000 0x0 0x20000000>,
+				 <0x02000000 0x0 0x40000000
+				  0x6 0x40000000 0x0 0x40000000>;
+
+			power-domains = <&ps_pcie>;
+			clocks = <&ps_pcie_aux>, <&ps_pcie_ref>;
+			clock-names = "aux", "ref";
+			status = "disabled";
+		};
 	};
 
 	timer {
