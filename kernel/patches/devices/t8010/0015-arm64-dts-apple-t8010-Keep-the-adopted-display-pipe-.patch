From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Wed, 4 Nov 2026 03:24:16 +0800
Subject: [PATCH] arm64: dts: apple: t8010: Keep the adopted display pipe
 powered over s2idle

The display controller takes over the timings and panel link that
iBoot set up; the driver cannot program them from scratch. When PMGR
powers the display domains down during suspend-to-idle, that state is
lost: on the iPad 6 the deeper PM tests then left the screen blank, and
an unblank ran into flip, FIFO and vblank timeouts.

Keep the display front and back end on for every T8010 board, and the
panel link domain each family uses: DisplayPort on the iPads, MIPI DSI
on the iPhones and the iPod touch. Only the domain a board drives is
kept on.

This keeps the state instead of restoring it, so the display does not
save power in suspend. Verified on the iPad 6 (J71b); the iPad 7,
iPhone 7 and iPod touch follow the same display adoption but are
untested.

Assisted-by: LLM
---
 arch/arm64/boot/dts/apple/t8010-7.dtsi     | 6 ++++++
 arch/arm64/boot/dts/apple/t8010-ipad6.dtsi | 6 ++++++
 arch/arm64/boot/dts/apple/t8010-n112.dts   | 6 ++++++
 arch/arm64/boot/dts/apple/t8010-pmgr.dtsi  | 4 ++++
 4 files changed, 22 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t8010-7.dtsi b/arch/arm64/boot/dts/apple/t8010-7.dtsi
index 50372e7e65db..ab47fe15d591 100644
--- a/arch/arm64/boot/dts/apple/t8010-7.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-7.dtsi
@@ -126,3 +126,9 @@ bluetooth: bluetooth {
 		device-wakeup-gpios = <&pinctrl_ap 87 GPIO_ACTIVE_HIGH>;
 	};
 };
+
+/* The adopted MIPI DSI panel link cannot be restored after power loss. */
+&ps_mipi_dsi {
+	apple,always-on;
+	apple,manual-pm;
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
index 924434224b97..2091e0cfd543 100644
--- a/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-ipad6.dtsi
@@ -301,3 +301,9 @@ &wlan_uart2 {
 	pinctrl-names = "default";
 	status = "okay";
 };
+
+/* The adopted DisplayPort panel link cannot be restored after power loss. */
+&ps_dp {
+	apple,always-on;
+	apple,manual-pm;
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-n112.dts b/arch/arm64/boot/dts/apple/t8010-n112.dts
index ed719c3e17e7..861b1e894675 100644
--- a/arch/arm64/boot/dts/apple/t8010-n112.dts
+++ b/arch/arm64/boot/dts/apple/t8010-n112.dts
@@ -82,3 +82,9 @@ rtc_offset: rtc-offset@4 {
 		};
 	};
 };
+
+/* The adopted MIPI DSI panel link cannot be restored after power loss. */
+&ps_mipi_dsi {
+	apple,always-on;
+	apple,manual-pm;
+};
diff --git a/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi b/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
index 4680e312ed75..921c3a570ae4 100644
--- a/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
+++ b/arch/arm64/boot/dts/apple/t8010-pmgr.dtsi
@@ -402,6 +402,8 @@ ps_disp0_fe: power-controller@802b0 {
 		#reset-cells = <0>;
 		label = "disp0_fe";
 		power-domains = <&ps_rtmux>;
+		apple,always-on; /* Display pipe adopted from iBoot */
+		apple,manual-pm;
 	};
 
 	ps_disp0_be: power-controller@802b8 {
@@ -411,6 +413,8 @@ ps_disp0_be: power-controller@802b8 {
 		#reset-cells = <0>;
 		label = "disp0_be";
 		power-domains = <&ps_disp0_fe>;
+		apple,always-on; /* Display pipe adopted from iBoot */
+		apple,manual-pm;
 	};
 
 	ps_pmp: power-controller@802f0 {
