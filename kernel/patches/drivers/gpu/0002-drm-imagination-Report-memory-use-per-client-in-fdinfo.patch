From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Henrik Klee <henrik@goat-code.com>
Date: Tue, 3 Nov 2026 05:15:49 +0800
Subject: [PATCH] drm/imagination: Report memory use per client in fdinfo

Implement show_fdinfo with drm_show_memory_stats() and a GEM status
callback, so /proc/<pid>/fdinfo/<fd> lists each client's buffers
(drm-total-memory, drm-shared-memory, drm-resident-memory) like other
DRM drivers do. Tools such as gputop and nvtop read these, and it shows
which processes hold the GPU's pinned memory.

Assisted-by: LLM
---
 drivers/gpu/drm/imagination/pvr_drv.c | 14 +++++++++++++-
 drivers/gpu/drm/imagination/pvr_gem.c | 11 +++++++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/imagination/pvr_drv.c b/drivers/gpu/drm/imagination/pvr_drv.c
index 5db075d..b911028 100644
--- a/drivers/gpu/drm/imagination/pvr_drv.c
+++ b/drivers/gpu/drm/imagination/pvr_drv.c
@@ -25,6 +25,7 @@
 #include <drm/drm_file.h>
 #include <drm/drm_gem.h>
 #include <drm/drm_ioctl.h>
+#include <drm/drm_print.h>
 
 #include <linux/err.h>
 #include <linux/export.h>
@@ -1377,7 +1378,17 @@ pvr_drm_driver_postclose(__always_unused struct drm_device *drm_dev,
 	file->driver_priv = NULL;
 }
 
-DEFINE_DRM_GEM_FOPS(pvr_drm_driver_fops);
+static void pvr_drm_driver_show_fdinfo(struct drm_printer *p,
+				       struct drm_file *file)
+{
+	drm_show_memory_stats(p, file);
+}
+
+static const struct file_operations pvr_drm_driver_fops = {
+	.owner = THIS_MODULE,
+	DRM_GEM_FOPS,
+	.show_fdinfo = drm_show_fdinfo,
+};
 
 static struct drm_driver pvr_drm_driver = {
 	.driver_features = DRIVER_GEM | DRIVER_RENDER |
@@ -1387,6 +1398,7 @@ static struct drm_driver pvr_drm_driver = {
 	.ioctls = pvr_drm_driver_ioctls,
 	.num_ioctls = ARRAY_SIZE(pvr_drm_driver_ioctls),
 	.fops = &pvr_drm_driver_fops,
+	.show_fdinfo = pvr_drm_driver_show_fdinfo,
 #if defined(CONFIG_DEBUG_FS)
 	.debugfs_init = pvr_debugfs_init,
 #endif
diff --git a/drivers/gpu/drm/imagination/pvr_gem.c b/drivers/gpu/drm/imagination/pvr_gem.c
index d8660d6..817b47d 100644
--- a/drivers/gpu/drm/imagination/pvr_gem.c
+++ b/drivers/gpu/drm/imagination/pvr_gem.c
@@ -52,8 +52,19 @@ static int pvr_gem_mmap(struct drm_gem_object *gem_obj, struct vm_area_struct *v
 	return drm_gem_shmem_mmap(shmem_obj, vma);
 }
 
+static enum drm_gem_object_status pvr_gem_object_status(struct drm_gem_object *obj)
+{
+	struct drm_gem_shmem_object *shmem_obj = to_drm_gem_shmem_obj(obj);
+
+	if (drm_gem_is_imported(obj) || shmem_obj->pages)
+		return DRM_GEM_OBJECT_RESIDENT;
+
+	return 0;
+}
+
 static const struct drm_gem_object_funcs pvr_gem_object_funcs = {
 	.free = pvr_gem_object_free,
+	.status = pvr_gem_object_status,
 	.print_info = drm_gem_shmem_object_print_info,
 	.export = pvr_gem_export,
 	.pin = drm_gem_shmem_object_pin,
-- 
