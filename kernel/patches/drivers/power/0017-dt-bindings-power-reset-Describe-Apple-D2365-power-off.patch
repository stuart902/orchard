From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 31 Oct 2026 20:53:12 -0300
Subject: [PATCH] dt-bindings: power: reset: Describe Apple D2365 power off

Describe the PMIC child for boards using the D2365 direct standby
sequence. Require a reference to the external supply because this
hardware follows a restart path rather than standby when a source is
attached.

Signed-off-by: Codex <codex@openai.com>
---
 .../devicetree/bindings/mfd/apple,pmic.yaml   |  3 ++
 .../power/reset/apple,d2365-poweroff.yaml     | 51 +++++++++++++++++++
 2 files changed, 54 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/reset/apple,d2365-poweroff.yaml

diff --git a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
index 947f839..47c31b3 100644
--- a/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/apple,pmic.yaml
@@ -60,6 +60,9 @@ properties:
   gpio:
     $ref: /schemas/gpio/apple,d2365-pmic-gpio.yaml
 
+  poweroff:
+    $ref: /schemas/power/reset/apple,d2365-poweroff.yaml#
+
 patternProperties:
   "^charger@[0-9a-f]+$":
     $ref: /schemas/power/supply/apple,d2365-charger.yaml
diff --git a/Documentation/devicetree/bindings/power/reset/apple,d2365-poweroff.yaml b/Documentation/devicetree/bindings/power/reset/apple,d2365-poweroff.yaml
new file mode 100644
index 0000000..29af6ec
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/reset/apple,d2365-poweroff.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/reset/apple,d2365-poweroff.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple D2365 PMIC power off
+
+maintainers:
+  - Stuart Fraser <me@stuartfraser.ca>
+
+description: |
+  The D2365 (Angel) PMIC can enter standby through its I2C register map.
+  This child of the PMIC describes boards using the PMIC's direct shutdown
+  sequence, not a separate external shutdown controller. Such boards restart
+  instead of entering standby while external power is connected. The supply
+  reference identifies the board's external power source.
+
+properties:
+  compatible:
+    const: apple,d2365-poweroff
+
+  power-supplies:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+    description: External USB or charger power supply.
+
+required:
+  - compatible
+  - power-supplies
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@3c {
+            compatible = "apple,angel-pmic", "apple,i2c-pmic";
+            reg = <0x3c>;
+            #address-cells = <1>;
+            #size-cells = <1>;
+
+            poweroff {
+                compatible = "apple,d2365-poweroff";
+                power-supplies = <&tristar_charger>;
+            };
+        };
+    };
